{
	"version": 1,
	"pythonPlugin": "PythonScriptPlugin",
	"plugins": [
		{
			"name": "PythonScriptPlugin",
			"required": true,
			"optionalReference": false,
			"copyToProject": false,
			"checkBuildId": true,
			"pythonProbes": [],
			"sources": [
				{
					"kind": "engine",
					"path": "Engine/Plugins/Experimental/PythonScriptPlugin"
				},
				{
					"kind": "debloat",
					"path": "Engine/Plugins/Experimental/PythonScriptPlugin"
				}
			],
			"description": "Python transport for the MCP server. Required."
		},
		{
			"name": "EditorScriptingUtilities",
			"required": false,
			"optionalReference": true,
			"copyToProject": true,
			"checkBuildId": true,
			"pythonProbes": [
				"EditorLevelLibrary",
				"EditorAssetLibrary"
			],
			"sources": [
				{
					"kind": "debloat",
					"path": "Engine/Plugins/Editor/EditorScriptingUtilities"
				},
				{
					"kind": "engine",
					"path": "Engine/Plugins/Editor/EditorScriptingUtilities"
				}
			],
			"description": "Editor actor, asset, and level scripting APIs."
		},
		{
			"name": "UEVNative",
			"required": false,
			"optionalReference": true,
			"copyToProject": true,
			"checkBuildId": true,
			"pythonProbes": [
				"UEVLibrary",
				"UEVGraphLibrary"
			],
			"sources": [
				{
					"kind": "integration",
					"path": "native/UEVNative"
				}
			],
			"description": "Native transaction and undo/redo bridge."
		},
		{
			"name": "UEVControlPanel",
			"required": false,
			"optionalReference": true,
			"copyToProject": true,
			"checkBuildId": true,
