				{
					"kind": "integration",
					"path": "native/UEVControlPanel"
				}
			],
			"description": "Native Slate in-editor control panel for the MCP server."
		},
		{
			"name": "SequencerScripting",
			"required": false,
			"optionalReference": true,
			"copyToProject": false,
			"checkBuildId": true,
			"pythonProbes": [
				"SequencerTools"
			],
			"sources": [
				{
					"kind": "engine",
					"path": "Engine/Plugins/MovieScene/SequencerScripting"
				},
				{
					"kind": "debloat",
					"path": "Engine/Plugins/MovieScene/SequencerScripting"
				}
			],
			"description": "Sequencer Python track and key APIs."
		},
		{
			"name": "RTXGI",
			"required": false,
			"optionalReference": true,
			"copyToProject": false,
			"checkBuildId": false,
			"pythonProbes": [
				"DDGIVolume",
				"DDGIVolumeComponent"
			],
			"sources": [
				{
					"kind": "engine",
					"path": "Engine/Plugins/Runtime/Nvidia/RTXGI"
				},
				{
					"kind": "debloat",
					"path": "Engine/Plugins/Runtime/Nvidia/RTXGI"
				}
			],
			"description": "Nvidia RTXGI/DDGI plugin."
		}
	],
	"modules": [
